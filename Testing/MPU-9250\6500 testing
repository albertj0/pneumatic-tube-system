#include <Wire.h>

const int MPU_ADDR = 0x68;
float pitch = 0;
float roll = 0;
unsigned long lastTime = 0;

void setup() {
  Serial.begin(115200);
  Wire.begin(); 
  
  // Wake up the MPU-6500/9250
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x6B); 
  Wire.write(0x00); 
  Wire.endTransmission(true);
  
  lastTime = millis();
}

void loop() {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B); 
  Wire.endTransmission(false);
  Wire.requestFrom(MPU_ADDR, 14, true); 

  if (Wire.available() == 14) {
    // Read Accel and Gyro bytes
    int16_t ax = Wire.read() << 8 | Wire.read(); 
    int16_t ay = Wire.read() << 8 | Wire.read(); 
    int16_t az = Wire.read() << 8 | Wire.read(); 
    Wire.read(); Wire.read(); // Skip Temperature bytes
    int16_t gx = Wire.read() << 8 | Wire.read();  
    int16_t gy = Wire.read() << 8 | Wire.read();  
    int16_t gz = Wire.read() << 8 | Wire.read();  

    // Convert raw values to standard units
    float accelX = ax / 16384.0;
    float accelY = ay / 16384.0;
    float accelZ = az / 16384.0;
    float gyroX = gx / 131.0;
    float gyroY = gy / 131.0;

    // Calculate time elapsed since last loop
    unsigned long currentTime = millis();
    float dt = (currentTime - lastTime) / 1000.0;
    lastTime = currentTime;

    // Calculate absolute pitch and roll from the accelerometer
    float accelPitch = atan2(accelY, sqrt(accelX * accelX + accelZ * accelZ)) * 180 / PI;
    float accelRoll = atan2(-accelX, accelZ) * 180 / PI;

    // Complementary Filter
    pitch = 0.98 * (pitch + gyroX * dt) + 0.02 * accelPitch;
    roll = 0.98 * (roll + gyroY * dt) + 0.02 * accelRoll;

    // Output formatted strictly for the Arduino Serial Plotter
    Serial.print("Pitch:");
    Serial.print(pitch);
    Serial.print(",");
    Serial.print("Roll:");
    Serial.println(roll);
  }
  
  delay(20);
}
