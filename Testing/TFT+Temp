#include <Adafruit_GFX.h>
#include <Adafruit_ST7735.h>
#include <Adafruit_TMP117.h>
#include <Wire.h>
#include <SPI.h>

// TFT Display Pins (matches your working setup)
#define TFT_CS    D1
#define TFT_DC    D2
#define TFT_RST   D3

// Initialize Display and Sensor objects
Adafruit_ST7735 tft = Adafruit_ST7735(TFT_CS, TFT_DC, TFT_RST);
Adafruit_TMP117 tmp117;

void setup() {
  Serial.begin(115200);

  // Initialize the TFT display
  tft.initR(INITR_BLACKTAB); // Change to GREENTAB or 18BLACKTAB if colors are off
  tft.fillScreen(ST77XX_BLACK);
  tft.setRotation(1); // Landscape mode

  // Draw the static UI text
  tft.setCursor(10, 20);
  tft.setTextColor(ST77XX_CYAN);
  tft.setTextSize(2);
  tft.println("Temperature:");

  // Initialize the TMP117 sensor
  if (!tmp117.begin()) {
    tft.setCursor(10, 60);
    tft.setTextColor(ST77XX_RED);
    tft.setTextSize(1);
    tft.println("Failed to find TMP117!");
    while (1) delay(10); // Halt execution if sensor is not found
  }
}

void loop() {
  // Create a variable to hold sensor data and fetch the latest reading
  sensors_event_t temp;
  tmp117.getEvent(&temp);

  // Draw a black rectangle over the old temperature value to erase it without clearing the whole screen
  tft.fillRect(10, 50, 140, 30, ST77XX_BLACK);

  // Print the new temperature value
  tft.setCursor(10, 50);
  tft.setTextColor(ST77XX_WHITE);
  tft.setTextSize(3); // Larger text for the reading
  tft.print(temp.temperature, 1); // Print with 1 decimal place
  tft.print(" C");

  // Wait 1 second before updating again
  delay(1000);
}
