#include <SPI.h>
#include <Adafruit_GFX.h>
#include <Adafruit_ST7735.h> 

// Define pins using the XIAO D-pin labels
#define TFT_CS    D1
#define TFT_RST   D2
#define TFT_A0    D3  // A0 is the Data/Command pin
#define TFT_SCK   D8  // SCK is Clock
#define TFT_SDA   D10 // SDA is MOSI

// Initialize the ST7735 display object
Adafruit_ST7735 tft = Adafruit_ST7735(TFT_CS, TFT_A0, TFT_RST);

void setup() {
  Serial.begin(115200);
  Serial.println("Starting XIAO ESP32S3 TFT Test...");

  // Route the hardware SPI to our chosen pins
  // SPI.begin(SCK, MISO, MOSI, CS); 
  // We use -1 for MISO since the display doesn't have one
  SPI.begin(TFT_SCK, -1, TFT_SDA, TFT_CS);

  // Initialize the display
  tft.initR(INITR_BLACKTAB);

  // Rotate screen to landscape
  tft.setRotation(1); 

  // Fill the screen with black
  tft.fillScreen(ST77XX_BLACK);

  // Draw a red rectangle border
  tft.drawRect(5, 5, tft.width() - 10, tft.height() - 10, ST77XX_RED);

  // Print test text
  tft.setCursor(15, 30);
  tft.setTextColor(ST77XX_WHITE);
  tft.setTextSize(2);
  tft.println("XIAO S3");

  tft.setCursor(15, 60);
  tft.setTextColor(ST77XX_GREEN);
  tft.setTextSize(1);
  tft.println("128x160 Display OK!");
  
  // Draw a quick graphics test
  tft.fillCircle(tft.width()/2, 95, 20, ST77XX_BLUE);
}

void loop() {
  // Static display, nothing needed in the loop
}
